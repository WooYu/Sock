# StockCal Docker 部署环境变量模板
# 复制本文件为 `.env`（Docker 部署，已被 gitignore）后填写真实值，再 `docker compose up -d --build`。
# 本地开发（不用 Docker 时）则复制为 `.env.local`，由 Spring Boot 直接读取。

# ===== 数据库（容器内 Postgres，请改强密码）=====
POSTGRES_DB=stockcal
POSTGRES_USER=stockcal
POSTGRES_PASSWORD=change-me-strong-password

# ===== AI 供应商（默认 DeepSeek，可切回 OpenAI，重启生效）=====
AI_API_KEY=
STOCKCAL_AI_BASE_URL=https://api.deepseek.com
STOCKCAL_AI_MODEL=deepseek-chat
# 切回 OpenAI 时改为：
# STOCKCAL_AI_BASE_URL=https://api.openai.com/v1
# STOCKCAL_AI_MODEL=gpt-4o-mini

# ===== A 股行情（Tushare，可选；留空则行情接口返回“不可用”）=====
TUSHARE_TOKEN=

# ===== 知识笔记（可选，容器内路径需配合卷挂载，见部署文档）=====
# STOCKCAL_NOTES_PATH=/notes

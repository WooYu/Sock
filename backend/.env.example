# Local development: copy to backend/.env.local and run Gradle from backend/.
# Matches compose.local.yaml. Keep these services bound to your own machine.
DATABASE_URL=jdbc:postgresql://localhost:5432/stockcal
DATABASE_USER=stockcal
DATABASE_PASSWORD=stockcal
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=8080

STOCKCAL_AUTH_REQUIRED=false
STOCKCAL_AI_ENABLED=false
STOCKCAL_KNOWLEDGE_AUTO_EXTRACT=false
STOCKCAL_NOTES_PATH=../notes
STOCKCAL_SCENARIO_JOBS_ENABLED=true

# Optional provider credentials; the public-quote + research-record workflow needs neither.
# TUSHARE_TOKEN=
# AI_API_KEY=

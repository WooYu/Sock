# Default local mode: public quotes plus the separate research-record backend.
# Optional last-resort Tushare backend; public sources are tried first:
# STOCKCAL_API_BASE_URL=http://localhost:8080
STOCKCAL_RECORDS_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=StockCal

# 原文双模型精简标签（服务端变量，请勿添加 NEXT_PUBLIC_ 前缀）
# AI_API_KEY=
# STOCKCAL_AI_BASE_URL=https://api.deepseek.com
# STOCKCAL_AI_MODEL=deepseek-chat
# STOCKCAL_TAG_MODEL_1=deepseek-chat
# 第二个提取器使用本地 Codex CLI，沿用本机配置与认证，不需要 OpenAI API Key。
# 可选覆盖；不填则使用 codex 的当前默认模型：
# STOCKCAL_CODEX_MODEL=
# STOCKCAL_CODEX_BIN=
